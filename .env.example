# Copy to .env and fill in values. Never commit .env.

# --- LLM (chat) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic

# --- Embeddings (ingestion / semantic search) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: Postgres (intel DBs) ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Optional: Qdrant ---
# VECTOR_STORE_TYPE=qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# --- Optional: APIs ---
# NVD_API_KEY=
# TAVILY_API_KEY=

# Optional second env file path (loaded after .env, non-overriding)
# ASTERASKILLS_ENV_FILE=
